# H-Zero — API Dockerfile
FROM python:3.11-slim

RUN useradd -m -s /bin/bash app && mkdir -p /app && chown -R app:app /app
WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]"
COPY . .
RUN pip install -e .

USER app
EXPOSE 8000
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
